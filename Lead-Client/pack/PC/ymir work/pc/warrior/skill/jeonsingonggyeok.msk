949Name			"전신공격"
949Description	"방어를 무시하고 전력을 다해 적을 공격한다"
List 949AffectData
{
	"공격력 : +%.0f" "1 + SkillPoint / 2" ""
	"방어력 : -%.0f" "SkillPoint / 2" ""
	"이동 속도 : -%.0f" "SkillPoint * 3" ""
}

