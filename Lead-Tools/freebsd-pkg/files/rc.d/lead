#!/bin/sh
#
# PROVIDE: lead
# REQUIRE: LOGIN mysql
# KEYWORD: shutdown
#
# rc.d script for the Lead game server. Starts every core in dependency order
# (db -> auth -> markserver -> channels) and stops them in reverse. Replaces the
# interactive start.sh / per-core run.sh.
#
# Enable and tune in /etc/rc.conf:
#   lead_enable="YES"
#   lead_user="lead"                 # account the cores run as
#   lead_rundir="/var/db/lead"       # per-core working directories
#   lead_cores="db:db auth:game markserver:game \
#               channel1/game2:game channel1/game1:game channel99:game"
#

. /etc/rc.subr

name="lead"
rcvar="lead_enable"

load_rc_config "$name"

: ${lead_enable:="NO"}
: ${lead_user:="lead"}
: ${lead_rundir:="/var/db/lead"}
: ${lead_prefix:="/usr/local"}
: ${lead_cores:="db:db auth:game markserver:game channel1/game2:game channel1/game1:game channel99:game"}
: ${lead_startdelay:="2"}

_libexec="${lead_prefix}/libexec/lead"
_piddir="/var/run/lead"

start_cmd="lead_start"
stop_cmd="lead_stop"
status_cmd="lead_status"
restart_cmd="lead_restart"
extra_commands="status restart"

_pidfile() { # _pidfile <corepath> -> sanitized pidfile path
	echo "${_piddir}/$(echo "$1" | tr '/' '_').pid"
}

lead_start()
{
	mkdir -p "$_piddir"
	# Self-heal the runtime tree / symlinks before each launch.
	PREFIX="$lead_prefix" LEAD_RUNDIR="$lead_rundir" LEAD_USER="$lead_user" \
		"${_libexec}/lead-layout" >/dev/null

	for entry in $lead_cores; do
		_core="${entry%%:*}"
		_bin="${entry##*:}"
		_dir="${lead_rundir}/${_core}"
		_pid="$(_pidfile "$_core")"
		_exe="${_libexec}/${_bin}"

		if [ ! -x "$_exe" ]; then
			warn "missing binary for core ${_core}: ${_exe}"
			continue
		fi
		if [ -f "$_pid" ] && kill -0 "$(cat "$_pid")" 2>/dev/null; then
			echo "lead: ${_core} already running (pid $(cat "$_pid"))"
			continue
		fi

		echo "lead: starting ${_core} ..."
		/usr/sbin/daemon -f -u "$lead_user" -p "$_pid" \
			/bin/sh -c "cd '${_dir}' && exec '${_exe}'"
		sleep "$lead_startdelay"
	done
}

lead_stop()
{
	# Stop in reverse start order so dependents die before db.
	_rev=""
	for entry in $lead_cores; do _rev="$entry $_rev"; done

	for entry in $_rev; do
		_core="${entry%%:*}"
		_pid="$(_pidfile "$_core")"
		[ -f "$_pid" ] || continue
		_p="$(cat "$_pid")"
		if kill -0 "$_p" 2>/dev/null; then
			echo "lead: stopping ${_core} (pid ${_p}) ..."
			kill -TERM "$_p" 2>/dev/null
			_n=0
			while kill -0 "$_p" 2>/dev/null && [ "$_n" -lt 15 ]; do
				sleep 1; _n=$((_n + 1))
			done
			kill -0 "$_p" 2>/dev/null && kill -KILL "$_p" 2>/dev/null
		fi
		rm -f "$_pid"
	done
}

lead_status()
{
	for entry in $lead_cores; do
		_core="${entry%%:*}"
		_pid="$(_pidfile "$_core")"
		if [ -f "$_pid" ] && kill -0 "$(cat "$_pid")" 2>/dev/null; then
			echo "lead: ${_core} is running (pid $(cat "$_pid"))"
		else
			echo "lead: ${_core} is NOT running"
		fi
	done
}

lead_restart()
{
	lead_stop
	sleep 1
	lead_start
}

run_rc_command "$1"
